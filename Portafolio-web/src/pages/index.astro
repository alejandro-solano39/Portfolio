---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import GithubIcon from "../components/icons/GitHub.astro";
import CVIcon from "../components/icons/CV.astro";
import LinkedinIcon from "../components/icons/Linkedin.astro";
import SocialPill from "../components/SocialPill.astro";
import MailIcon from "../components/icons/Mail.astro";
import Experience from "../components/Experience.astro";
import Proyects from "../components/Projects.astro";
import AboutMe from "../components/AboutMe.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/Code.astro";
import ScrollToTop from "../components/ScrollToTop.astro"; 
---
<Layout title="Porfolio de César Alejandro - Ingeniero de Software y Programador Web"
description="Contrata un ingeniero de software con conocimiento en el desarrollo web">

<main class="container mx-auto px-4 sm:px-6 md:px-8 lg:px-10">
  <!-- Sección principal centrada -->
  <SectionContainer class="py-16 md:py-24 lg:py-32 flex flex-col items-center justify-center text-center mx-auto w-full">
    <img
      class="rounded-full w-36 h-36 sm:w-44 sm:h-44 md:w-52 md:h-52 lg:w-56 lg:h-56 mb-6 object-cover"
      src="/public/profile/profile_image.webp"
      alt="Alejandro photo"
    />
    <h1 class="text-black text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold flex flex-col items-center gap-y-4 pb-4 sm:pb-6 lg:pb-10">
      Hey, soy César Alejandro Solano Enciso
      <a
        href="https://www.linkedin.com/in/c%C3%A9sar-alejandro-solano-enciso-7912922b7/"
        target="_blank"
        rel="noopener"
        class="flex justify-center items-center"
      >
        <Badge>Disponible para trabajar</Badge>
      </a>
    </h1>

    <h2 class="text-base sm:text-lg md:text-xl lg:text-2xl opacity-80 max-w-[90%] sm:max-w-[700px] text-gray-950 mx-auto">
      +2 años de experiencia. <span class="text-blue-900">Ingeniero de Software y Programador Full Stack</span> de Manzanillo, México. Especializado en el desarrollo de sitios web funcionales y optimizados.
    </h2>

    <nav class="flex flex-wrap gap-6 mt-8 justify-center">
      <SocialPill href="www.linkedin.com/in/césar-alejandro-solano-enciso-7912922b7" target="_blank" rel="noopener noreferrer">
        <LinkedinIcon class="size-4 md:size-6" />
        Linkedin
      </SocialPill>
      <SocialPill href="https://github.com/alejandro-solano39" target="_blank" rel="noopener noreferrer">
        <GithubIcon class="size-4 md:size-6" />
        Github
      </SocialPill>
      <SocialPill href="/public/CV-ALEJANDRO-SOLANO.pdf" target="_blank" rel="noopener noreferrer">
        <CVIcon class="size-4 md:size-6" />
        CV
      </SocialPill>
      <SocialPill href="mailto:csolano3019@gmail.com" target="_blank" rel="noopener noreferrer">
        <MailIcon class="size-4 md:size-6" />
        csolano3019@gmail.com
      </SocialPill>
    </nav>
  </SectionContainer>

  <!-- Otras secciones -->
  <SectionContainer id="experiencia" class="mx-auto w-full max-w-screen-lg px-4 sm:px-6 md:px-8 lg:px-10">
    <h2 class="text-2xl sm:text-3xl font-semibold mb-6 flex gap-x-3 items-center justify-center">
      <Briefcase class="size-6 sm:size-8" />
      Experiencia laboral
    </h2>
    <Experience />
  </SectionContainer>

  <SectionContainer id="proyectos" class="mx-auto w-full max-w-screen-lg px-4 sm:px-6 md:px-8 lg:px-10">
    <h2 class="text-2xl sm:text-3xl font-semibold mb-6 flex gap-x-3 items-center justify-center">
      <CodeIcon class="size-6 sm:size-8" />
      Proyectos
    </h2>
    <Proyects />
  </SectionContainer>

  <SectionContainer id="AcercaDeMi" class="mx-auto w-full max-w-screen-lg px-4 sm:px-6 md:px-8 lg:px-10">
    <h2 class="text-2xl sm:text-3xl font-semibold mb-6 flex gap-x-3 items-center justify-center">
      <CodeIcon class="size-6 sm:size-8" />
      Acerca de mí
    </h2>
    <AboutMe />
  </SectionContainer>

  <!-- Botón ScrollToTop -->
  <ScrollToTop />
</main>
</Layout>
