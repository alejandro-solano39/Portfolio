---
import HTML from "./icons/HTML.astro";
import CSS from "./icons/CSS.astro";
import PHP from "./icons/PHP.astro";
import JS from "./icons/JavaScript.astro";
import TAILWIND from "./icons/Tailwind_CSS.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  HTML: {
    name: "HTML",
    class: "bg-[#ffedd5] text-black",
    icon: HTML,
  },

  CSS: {
    name: "CSS",
    class: "bg-[#ede9fe] text-black",
    icon: CSS,
  },

  PHP: {
    name: "PHP",
    class: "bg-[#f3f4f6] text-black",
    icon: PHP,
  },

  JS: {
    name: "JavaScript",
    class: "bg-[#fef9c3] text-black",
    icon: JS,
  },

  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#dbeafe] text-black",
    icon: TAILWIND,
  },

  Bootstrap: {
    name: "Bootstrap",
    class: "bg-[#c4b5fd] text-black",
    icon: Bootstrap,
  },
};

const PROJECTS = [
  {
    title: "VIONS - Innovative Marketing & Design",
    description:
      "Plataforma para la gestión y promoción de artistas, diseñada y desarrollada desde cero con HTML, CSS, JavaScript y PHP. El sitio incluye un sistema administrativo robusto y funcionalidades avanzadas de seguridad. Optimizado para SEO, generando un incremento significativo en la visibilidad. En constante mantenimiento y mejora para garantizar una experiencia fluida y profesional.",
    link: "https://www.vions.com.mx/",
    image: "/proyects/proyect-VIONS.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JS, TAGS.PHP, TAGS.Bootstrap],
  },
  {
    title: "IT ARKON | Software Solutions",
    description:
      "Desarrollé desde cero el sitio web corporativo utilizando HTML, CSS, PHP y JavaScript. Implementé funcionalidades centradas en la experiencia del usuario y estrategias avanzadas de SEO, mejorando la visibilidad y el tráfico del sitio. Además, optimicé el rendimiento y garantizé un diseño responsivo y seguro, alineado con los estándares de la industria.",
    link: "https://www.it-arkon.net/",
    image: "/proyects/proyect-IT-ARKON.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JS, TAGS.PHP, TAGS.TAILWIND],
  },
];
---

{
  (
    // <article>
    //   <h3 class="text-2xl font-semibold text-blue-950 mb-2 mt-4">{title}</h3>
    //   <p class="text-lg mb-4 text-pretty">{description}</p>
    //   <ul class="flex flex-row mb-2 gap-x-2">
    //       {tags.map((tag) => (
    //         <li>
    //           <span
    //             class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
    //           >
    //             <tag.icon class="size-4" />
    //             {tag.name}
    //           </span>
    //         </li>
    //       ))}
    //     </ul>
    //   <img
    //     class="rounded shadow-2xl shadow-blue-300/10"
    //     src={image}
    //     alt={"Captura de pantalla del proyecto ${image}"}
    //   />
    // </article>

    <div class="flex flex-col gap-y-16">
      {PROJECTS.map(({ image, title, description, tags, link, github }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl">
              <img
                alt="Foto mia en CDMX"
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-blue-950">{title}</h3>
            <div class="flex flex-wrap mt-2">
              <ul class="flex flex-wrap gap-2 mb-2">
                {tags.map((tag) => (
                  <li>
                    <span
                      class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 whitespace-nowrap`}
                    >
                      <tag.icon class="size-4" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-2 text-gray-900">{description}</div>
              <footer class="flex items-end justify-start mt-4 gap-x-4">
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-6" />
                    Code
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    Preview
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      ))}
    </div>
  )
}
