---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Actualmente...",
    title: "Desarrollo e Implementación del Sitio Web para VIONS",
    company: "VIONS",
    description:
      "Como parte de la startup VIONS, diseñé, desarrollé y mantengo su sitio web oficial, alineado con su visión innovadora de fusionar arte visual y musical. Implementé funcionalidades avanzadas como la gestión de perfiles de artistas y un sistema administrativo, además de optimizar el sitio con estrategias de SEO para aumentar su visibilidad y atraer tráfico cualificado.",
  },
  {
    date: "Noviembre 2023 - Mayo 2024",
    title: " Desarrollador Full Stack ",
    company: "IT ARKON",
    description:
      "Diseñé y desarrollé el sitio web corporativo de IT ARKON utilizando HTML, CSS, PHP y JavaScript, mejorando la experiencia del usuario, el rendimiento y la visibilidad en motores de búsqueda. Además, implementé funcionalidades específicas en un sistema web aduanero con React y Node.js, optimizando la usabilidad y el valor agregado del sistema.",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
