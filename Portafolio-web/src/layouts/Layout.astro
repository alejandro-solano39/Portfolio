---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
// Supports weights 100-900
import "@fontsource-variable/onest";
interface Props {
  title: string;
  description: string;
}

const { title, description} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="{description}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <div class="background"></div>
    <div class="content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  /* General reset para evitar márgenes y padding inesperados */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Establece el diseño básico */
  html {
    font-family: "Onest Variable", sans-serif;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: white;
    overflow-x: hidden; /* Evita que el cuerpo tenga desplazamiento horizontal */
  }

  /* Fondo con forma redondeada */
  .background {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%) translateY(20%);
    width: 500px;
    height: 500px;
    background-color: #98cfff;
    opacity: 0.5;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -10;
  }

  /* Ajuste responsivo para pantallas más pequeñas */
  @media (max-width: 768px) {
    .background {
      width: 400px;
      height: 400px;
      top: 0;
      left: 50%;
      transform: translateX(-50%) translateY(20%);
    }
  }

  /* Contenedor principal con márgenes laterales */
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    max-width: 100%;
    overflow-x: hidden; /* Evita desbordes horizontales */
    padding: 0 20px; /* Agrega margen a los lados */
    margin-top: 50px; /* Ajusta el margen para que el contenido no se pegue al top */
  }

  /* Para dispositivos grandes, añade más espacio lateral */
  @media (min-width: 1024px) {
    .content {
      padding-left: 40px; /* Agrega más espacio lateral izquierdo */
      padding-right: 40px; /* Agrega más espacio lateral derecho */
    }
  }

  /* Asegura que los elementos dentro del header y footer se ajusten bien */
  header, footer {
    width: 100%;
  }

  /* Asegura que los elementos dentro de body no se desborden en pantallas pequeñas */
  @media (max-width: 768px) {
    body {
      padding: 10px;
    }
    .content {
      padding: 20px 10px;  /* Ajuste en el padding para más espacio lateral */
      margin-top: 20px;
    }
  }

  /* Para accesibilidad y rendimiento con preferencia por reducir movimiento */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
